<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="inimene" type="inimeneTuup"/>

  <xs:complexType name="inimeneTuup">
    <xs:sequence>
      <xs:element name="nimi" type="xs:string"/>
      <xs:element name="lapsed" type="lapsedTuup" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="synd" type="xs:gYear" use="required"/>
    <xs:attribute name="surm" type="xs:gYear" use="optional"/>
  </xs:complexType>

  <xs:complexType name="lapsedTuup">
    <xs:sequence>
      <xs:element ref="inimene" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
