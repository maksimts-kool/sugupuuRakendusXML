@using System.Xml.Linq
@using System.Xml.Xsl
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Sugupuu";

    var xmlFail = System.IO.Path.Combine(Env.WebRootPath, "ElisavetaSugupuu.xml");

    var xslt = new XslCompiledTransform();
    xslt.Load(System.IO.Path.Combine(Env.WebRootPath, "sugupuuParing.xslt"));
    var args = new XsltArgumentList();
    args.AddParam("aasta", "", DateTime.Now.Year);
    using var writer = new StringWriter();
    xslt.Transform(xmlFail, args, writer);

    var puu = XDocument.Load(xmlFail);
}

<h1>@ViewData["Title"]</h1>

@Html.Raw(writer.ToString())

<h2>Tabel</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nimi</th>
            <th>Aasta</th>
            <th>Vanus</th>
            <th>1. täht</th>
            <th>Viimane täht</th>
            <th>Tähtede arv</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in puu.Descendants("inimene"))
        {
            var nimi = (string)i.Element("nimi");
            var synd = (int)i.Attribute("synd");
            var tahed = nimi.Replace(" ", "");
            <tr>
                <td>@nimi</td>
                <td>@synd</td>
                <td>@(DateTime.Now.Year - synd)</td>
                <td>@tahed[0]</td>
                <td>@tahed[^1]</td>
                <td>@tahed.Length</td>
            </tr>
        }
    </tbody>
</table>
