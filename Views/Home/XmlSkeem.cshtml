@using System.Xml
@using System.Xml.Schema
@using System.Net
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "XML skeem";

    var wwwroot = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot");
    var xsdFail = System.IO.Path.Combine(wwwroot, "sugupuu.xsd");

    var xsdKood = Regex.Replace(
        WebUtility.HtmlEncode(System.IO.File.ReadAllText(xsdFail)),
        @"(?<kommentaar>&lt;!--.*?--&gt;)|(?<vaartus>&quot;.*?&quot;)|(?<silt>&lt;[/?]?[\w:]+|[/?]?&gt;)|(?<atribuut>[\w:]+(?==))",
        m => m.Groups["kommentaar"].Success ? $"<span class=\"xml-kommentaar\">{m.Value}</span>"
           : m.Groups["vaartus"].Success ? $"<span class=\"xml-vaartus\">{m.Value}</span>"
           : m.Groups["silt"].Success ? $"<span class=\"xml-silt\">{m.Value}</span>"
           : $"<span class=\"xml-atribuut\">{m.Value}</span>",
        RegexOptions.Singleline);

    var kontrollitavad = new[] { "ElisavetaSugupuu.xml", "MinuSugupuu.xml" };
    var tulemused = new List<(string Fail, List<string> Vead)>();

    foreach (var fail in kontrollitavad)
    {
        var vead = new List<string>();
        var seaded = new XmlReaderSettings { ValidationType = ValidationType.Schema };
        seaded.Schemas.Add(null, xsdFail);
        seaded.ValidationEventHandler += (s, e) => vead.Add(e.Message);

        using (var lugeja = XmlReader.Create(System.IO.Path.Combine(wwwroot, fail), seaded))
        {
            while (lugeja.Read()) { }
        }
        tulemused.Add((fail, vead));
    }
}

<h1>@ViewData["Title"]</h1>

<p>XML skeem (XSD) kirjeldab, milline peab olema sugupuu XML faili struktuur.</p>

<h2>sugupuu.xsd</h2>
<pre class="xml-kood"><code>@Html.Raw(xsdKood)</code></pre>

<h2>Valideerimine</h2>
<ul>
    @foreach (var (fail, vead) in tulemused)
    {
        <li>
            <strong>@fail</strong> -
            @if (vead.Count == 0)
            {
                <span class="text-success">vastab skeemile</span>
            }
            else
            {
                <span class="text-danger">ei vasta skeemile</span>
                <ul>
                    @foreach (var viga in vead)
                    {
                        <li>@viga</li>
                    }
                </ul>
            }
        </li>
    }
</ul>
